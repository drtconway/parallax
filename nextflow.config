// Nextflow configuration for parallax pipeline

// Default parameters
params {
    fasta = null
    fastq = null
    index = null
    outdir = 'results'
    threads = 4
    primary_only = true
    config = null
}

// Process defaults
process {
    // Default container (if using Docker/Singularity)
    // container = 'parallax:latest'
    
    errorStrategy = 'retry'
    maxRetries = 1
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
    }
    
    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'
        process.time = '4h'
        process.memory = '32 GB'
    }
    
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

// Resource limits
executor {
    $local {
        cpus = 8
        memory = '32 GB'
    }
}

// Timeline and reports
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
}

// Manifest
manifest {
    name = 'parallax-pipeline'
    author = 'Tom Conway'
    description = 'Nextflow pipeline for parallax sequence alignment'
    version = '0.1.0'
    nextflowVersion = '>=23.04.0'
}
