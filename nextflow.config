// Nextflow configuration for parallax pipeline

// Default parameters
params {
    // Input files
    fasta = null           // Reference FASTA (required)
    fastq = null           // Single FASTQ file (use this OR samplesheet)
    samplesheet = null     // CSV samplesheet for batch processing
    index = null           // Index directory (will be created if doesn't exist)
    config = null          // Parallax TOML config file
    bed = null             // BED file for targeted indexing
    
    // Output
    outdir = 'results'
    
    // Index/alignment options
    threads = 4
    primary_only = true
    portable = false       // Use portable index format (slower I/O, smaller files)
    
    // Read group info (single-sample mode only)
    // For batch mode, include these columns in samplesheet
    sample = null          // Sample name (--rg-sm)
    platform = null        // Platform: ILLUMINA, PACBIO, ONT (--rg-pl)
    library = null         // Library identifier (--rg-lb)
    platform_unit = null   // Platform unit / flowcell.lane (--rg-pu)
    center = null          // Sequencing center (--rg-cn)

    // Shell commands run before every task, e.g. 'module load samtools minimap2'
    modules_cmd = null

    // Extra run_clair3.sh arguments (evaluate.nf).  Declared here, not in the
    // script, because the CLAIR3 ext.args closure below only sees config params.
    clair3_args = ''

    // Let Clair3 use supplementary alignments (evaluate.nf).  Runs the slower
    // non-C pipeline (--disable_c_impl) with assets/clair3/param_{p,f}.py
    // bind-mounted over the image's copies; outputs are named *.supp.*.
    clair3_supplementary = false
}

// The config parser allows no functions, so the clair3_supplementary test is
// repeated inline below; toString() because '--x false' arrives as "false".

// Process defaults
process {
    // Default container (if using Docker/Singularity)
    // container = 'parallax:latest'
    
    errorStrategy = 'retry'
    maxRetries = 1

    // Always run SETUP_PYTHON on the submit node so pyenv and build tools are
    // available and the shared-filesystem .venv path is accessible.
    withName: 'SETUP_PYTHON' {
        executor = 'local'
    }

    beforeScript = params.modules_cmd ?: ''

    // Resource labels (used by evaluate.nf)
    withLabel: 'small' {
        cpus = 1
        memory = '4 GB'
        time = '2h'
    }
    withLabel: 'index' {
        cpus = 16
        memory = '64 GB'
        time = '12h'
    }
    withLabel: 'align' {
        cpus = 16
        memory = '48 GB'
        time = '8h'
    }
    withLabel: 'metrics' {
        cpus = 2
        memory = '8 GB'
        time = '4h'
    }
    withLabel: 'sort' {
        cpus = 8
        memory = '32 GB'
        time = '4h'
    }
    withLabel: 'pileup' {
        cpus = 1
        memory = '8 GB'
        time = '4h'
    }

    // nf-core clair3 module (evaluate.nf): one whole-genome call per merged BAM
    withName: 'CLAIR3' {
        cpus = 16
        memory = '64 GB'
        time = '24h'
        tag = { "${meta.id}.${meta.ref}.${meta.aligner}" }
        ext.prefix = { "${meta.id}.${meta.ref}.${meta.aligner}${params.clair3_supplementary.toString().toLowerCase() in ['true', 'yes', '1'] ? '.supp' : ''}." }
        ext.args = { ((params.clair3_args ?: '') + (params.clair3_supplementary.toString().toLowerCase() in ['true', 'yes', '1'] ? ' --disable_c_impl' : '')).trim() }
        containerOptions = {
            if (!(params.clair3_supplementary.toString().toLowerCase() in ['true', 'yes', '1'])) return ''
            def bind = workflow.containerEngine in ['singularity', 'apptainer'] ? '-B' : '-v'
            ['param_p.py', 'param_f.py']
                .collect { "${bind} ${projectDir}/assets/clair3/${it}:/opt/bin/shared/${it}" }
                .join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/vcf" },
            mode: 'copy',
            pattern: '*.{vcf.gz,vcf.gz.tbi}',
        ]
    }

    // nf-core bcftools/norm module (evaluate.nf): normalise each Clair3 VCF.
    // bcftools indexes the reference itself (the module stages only the FASTA).
    withName: 'BCFTOOLS_NORM' {
        cpus = 2
        memory = '8 GB'
        time = '2h'
        tag = { "${meta.id}.${meta.ref}.${meta.aligner}" }
        ext.prefix = { "${meta.id}.${meta.ref}.${meta.aligner}${params.clair3_supplementary.toString().toLowerCase() in ['true', 'yes', '1'] ? '.supp' : ''}.norm" }
        ext.args = '--output-type z --write-index=tbi --multiallelics -any --check-ref w'
        publishDir = [
            path: { "${params.outdir}/vcf" },
            mode: 'copy',
            pattern: '*.norm.vcf.gz*',
        ]
    }
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
        // Cap label requests (sized for the HPC) to what this machine has
        process.resourceLimits = [ cpus: 8, memory: 32.GB ]
    }
    
    slurm {
        process.executor = 'slurm'
        process.queue = 'prod_med'
        process.time = '4h'
        process.memory = '32 GB'
        executor.queueSize = 200
        executor.submitRateLimit = '10/1sec'
    }
    
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

// Resource limits
executor {
    $local {
        cpus = 8
        memory = '32 GB'
    }
}

// Timeline and reports
timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.txt"
}

// Manifest
manifest {
    name = 'parallax-pipeline'
    author = 'Tom Conway'
    description = 'Nextflow pipeline for parallax sequence alignment'
    version = '0.1.0'
    nextflowVersion = '>=23.04.0'
}
