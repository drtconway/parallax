// Nextflow configuration for parallax pipeline

// Default parameters
params {
    // Input files
    fasta = null           // Reference FASTA (required)
    fastq = null           // Single FASTQ file (use this OR samplesheet)
    samplesheet = null     // CSV samplesheet for batch processing
    index = null           // Index directory (will be created if doesn't exist)
    config = null          // Parallax TOML config file
    bed = null             // BED file for targeted indexing
    
    // Output
    outdir = 'results'
    
    // Index/alignment options
    threads = 4
    primary_only = true
    portable = false       // Use portable index format (slower I/O, smaller files)
    
    // Read group info (single-sample mode only)
    // For batch mode, include these columns in samplesheet
    sample = null          // Sample name (--rg-sm)
    platform = null        // Platform: ILLUMINA, PACBIO, ONT (--rg-pl)
    library = null         // Library identifier (--rg-lb)
    platform_unit = null   // Platform unit / flowcell.lane (--rg-pu)
    center = null          // Sequencing center (--rg-cn)
}

// Process defaults
process {
    // Default container (if using Docker/Singularity)
    // container = 'parallax:latest'
    
    errorStrategy = 'retry'
    maxRetries = 1
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
    }
    
    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'
        process.time = '4h'
        process.memory = '32 GB'
    }
    
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

// Resource limits
executor {
    $local {
        cpus = 8
        memory = '32 GB'
    }
}

// Timeline and reports
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
}

// Manifest
manifest {
    name = 'parallax-pipeline'
    author = 'Tom Conway'
    description = 'Nextflow pipeline for parallax sequence alignment'
    version = '0.1.0'
    nextflowVersion = '>=23.04.0'
}
